# --- Access (generate random values: python3 -c "import secrets;print(secrets.token_hex(16))") ---
API_KEYS=change-me-benchmark-key          # comma-separated, one per evaluator
ADMIN_KEYS=change-me-admin-key            # refinement-data import only
DASHBOARD_TOKEN=                          # set in production; dashboard then needs ?token=...
PHONE_HASH_SALT=change-me
POSTGRES_PASSWORD=change-me               # docker compose only

# --- Models (open weights, self-hosted) ---
LLM_PROVIDER=ollama                       # ollama | openai_compat | none
LLM_BASE_URL=http://localhost:11434
LLM_MODEL=gemma3:4b
GENERATE_KINYARWANDA=false                # keep false until a model passes the Kinyarwanda benchmark
LLM_MAX_CONCURRENCY=2                     # extra live requests get curated text immediately
ML_SERVICE_URL=http://localhost:7860      # speech, translation, photo diagnosis (ml_service/)
ML_TOKEN=change-me-ml-token
ML_DEVICE=cpu                             # cpu | cuda | mps
ASR_MODEL=badrex/w2v-bert-2.0-kinyarwanda-asr   # GPU hosts: DigitalUmuganda/whisper_small_kinyarwanda

# --- Channels ---
AT_USERNAME=sandbox                       # Africa's Talking: USSD callback POST /ussd, SMS POST /sms/inbound
AT_API_KEY=
AT_SENDER_ID=
AT_SANDBOX=true
WHATSAPP_TOKEN=                           # WhatsApp Cloud API: webhook GET/POST /whatsapp/webhook
WHATSAPP_PHONE_ID=
WHATSAPP_VERIFY_TOKEN=

# --- Privacy ---
RETENTION_DAYS=365                        # interactions older than this are deleted
