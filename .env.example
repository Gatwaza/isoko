# --- Model (open-source, self-hosted) ---
LLM_PROVIDER=ollama            # ollama | openai_compat | none
LLM_BASE_URL=http://localhost:11434
LLM_MODEL=llama3.2
GENERATE_KINYARWANDA=false     # keep false until a model passes the Kinyarwanda benchmark
MIN_RETRIEVAL_SCORE=3.0

# --- Access ---
API_KEYS=change-me-benchmark-key
DASHBOARD_TOKEN=               # set in production; dashboard then needs ?token=...
PHONE_HASH_SALT=change-me

# --- Africa's Talking (USSD callback: POST /ussd, inbound SMS: POST /sms/inbound) ---
AT_USERNAME=sandbox
AT_API_KEY=
AT_SENDER_ID=
AT_SANDBOX=true
